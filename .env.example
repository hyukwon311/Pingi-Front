# 핑이 프론트엔드 환경변수
# Docker 빌드 시에는 docker-compose.yml의 build args가 우선한다.

# API 서버 URL (백엔드 REST API)
# 로컬 개발: http://localhost:8000/v1 (백엔드 직접 접근)
# Docker 배포: /v1 (nginx 리버스 프록시 경유)
VITE_API_URL=http://localhost:8000/v1

# WebSocket URL (Socket.io는 HTTP로 연결 후 WebSocket 업그레이드)
# 로컬 개발: http://localhost:8000 (ws:// 아님 — Socket.io가 HTTP 핸드셰이크 수행)
# Docker 배포: 빈 값 → window.location.origin 사용 (nginx 프록시 경유)
VITE_WS_URL=http://localhost:8000
